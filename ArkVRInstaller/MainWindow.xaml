<Window Icon="app.ico" x:Class="ArkVRInstaller.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="ARK VR - Installateur &amp; Optimiseur (Edition Francaise v1.3.0) • LordMadTrix"

        Height="700" Width="840" MinHeight="600" MinWidth="760"

        WindowStartupLocation="CenterScreen"

        ResizeMode="CanResize"

        Background="#070B0E"

        Foreground="#E0F7FA"

        FontFamily="Segoe UI"

        Loaded="Window_Loaded">



    <Window.Resources>

        <!-- Styles et couleurs neon Tek et Jurassique -->

        <SolidColorBrush x:Key="BgDark" Color="#070B0E" />

        <SolidColorBrush x:Key="CardBg" Color="#0D151B" />

        <SolidColorBrush x:Key="CardBorder" Color="#1A2D38" />

        <SolidColorBrush x:Key="TekCyan" Color="#00F0FF" />

        <SolidColorBrush x:Key="TekEmerald" Color="#00FF88" />

        <SolidColorBrush x:Key="TextDim" Color="#8FA7B3" />



        <Style x:Key="CardPanel" TargetType="Border">

            <Setter Property="Background" Value="#0D151B" />

            <Setter Property="BorderBrush" Value="#1A2D38" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="CornerRadius" Value="8" />

            <Setter Property="Padding" Value="16" />

            <Setter Property="Margin" Value="0,0,0,12" />

        </Style>



        <Style x:Key="GlowingButton" TargetType="Button">

            <Setter Property="Background" Value="#00E5FF" />

            <Setter Property="Foreground" Value="#051015" />

            <Setter Property="FontWeight" Value="Bold" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="Padding" Value="16,11" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#33EFFF" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#00B8CC" />

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="border" Property="Background" Value="#1A2E38" />

                                <Setter Property="Foreground" Value="#4A6070" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="EmeraldButton" TargetType="Button" BasedOn="{StaticResource GlowingButton}">

            <Setter Property="Background" Value="#00FF88" />

            <Setter Property="Foreground" Value="#031A0F" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#33FFA0" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#00CC6A" />

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="border" Property="Background" Value="#0A2018" />

                                <Setter Property="Foreground" Value="#2A6040" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="DarkButton" TargetType="Button">

            <Setter Property="Background" Value="#142129" />

            <Setter Property="Foreground" Value="#90CAF9" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="Padding" Value="14,8" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="BorderBrush" Value="#253E4D" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}"

                                BorderBrush="{TemplateBinding BorderBrush}"

                                BorderThickness="{TemplateBinding BorderThickness}"

                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#1E3345" />

                                <Setter TargetName="border" Property="BorderBrush" Value="#4A7A9B" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="#0D1E2A" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Style pour les lignes de log -->

        <Style x:Key="LogItem" TargetType="ListBoxItem">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="#8FA7B3" />

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="FontFamily" Value="Consolas" />

            <Setter Property="Padding" Value="4,2" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <ContentPresenter />

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <!-- Header -->

        <Border Grid.Row="0" Background="#050D12" BorderBrush="#0F2030" BorderThickness="0,0,0,1" Padding="20,16">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🦕 ARK VR" FontSize="22" FontWeight="Black" Foreground="#00F0FF" />

                        <Border Background="#00FF88" CornerRadius="4" Padding="8,2" Margin="10,4,0,0" VerticalAlignment="Center">

                            <TextBlock Text="EDITION FRANCAISE v1.3.0" FontSize="10" FontWeight="Bold" Foreground="#021A0E" />

                        </Border>

                        <Border x:Name="BadgeUEVR" Background="#1A2030" CornerRadius="4" Padding="8,2" Margin="6,4,0,0" VerticalAlignment="Center" Visibility="Collapsed">

                            <TextBlock x:Name="TxtUevrBadge" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" />

                        </Border>

                    </StackPanel>

                    <TextBlock Text="Survie Jurassique 6DOF, Vol Aerien en Pteranodon &amp; Rendu Stereoscopique UEVR" FontSize="12" Foreground="#8FA7B3" Margin="0,4,0,0" />

                    <TextBlock x:Name="TxtGpuInfo" Text="🔍 Detection GPU..." FontSize="11" Foreground="#4A6070" Margin="0,3,0,0" />

                </StackPanel>

                <Border Grid.Column="1" Background="#0A1820" BorderBrush="#1A3040" BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">

                    <TextBlock Text="✍ Signe LordMadTrix" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" />

                </Border>

            </Grid>

        </Border>



        <!-- Corps principal -->

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,12,16,0">

            <StackPanel>



                <!-- Carte : Repertoire de jeu -->

                <Border Style="{StaticResource CardPanel}">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                            <TextBlock Text="📁 DOSSIER DU JEU (ARK: SURVIVAL EVOLVED)" FontWeight="Bold" FontSize="13" Foreground="#00F0FF" />

                        </StackPanel>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtGamePath" TextChanged="TxtGamePath_TextChanged" Grid.Column="0" Background="#06090C" Foreground="#E0F7FA" BorderBrush="#253E4D" BorderThickness="1" Padding="10,8" FontSize="13" VerticalContentAlignment="Center"

                                     ToolTip="Chemin vers le dossier racine d'ARK: Survival Evolved (ex: D:\SteamLibrary\steamapps\common\ARK)" />

                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="Parcourir..." Style="{StaticResource DarkButton}" Margin="8,0,0,0" Click="BtnBrowse_Click" />

                            <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="📂 Ouvrir" Style="{StaticResource DarkButton}" Margin="6,0,0,0" Click="BtnOpenFolder_Click"

                                    ToolTip="Ouvrir le dossier ARK dans l'explorateur Windows" />

                        </Grid>

                        <TextBlock x:Name="TxtDetectStatus" Text="🔍 Recherche de ShooterGame.exe..." FontSize="12" Foreground="#00FF88" Margin="0,6,0,0" />

                    </StackPanel>

                </Border>



                <!-- Carte : Profils de Performance -->

                <Border Style="{StaticResource CardPanel}">

                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBlock Text="🎛️ SELECTION DU PROFIL DE PERFORMANCE VR" FontWeight="Bold" FontSize="13" Foreground="#00F0FF" />
                                <TextBlock x:Name="TxtAutoProfile" Text="" FontSize="11" Foreground="#00FF88" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="BtnOpenDLSS5" Grid.Column="1" Content="⚡ DLSS 5 Swapper (F8)" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="11" Click="BtnOpenDLSS5_Click"
                                    ToolTip="Ouvrir DLSS 5 Swapper v2.2.1 (En jeu, appuyez sur F8 pour afficher le panneau neuronal)" />
                        </Grid>

                        </StackPanel>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>



                            <RadioButton x:Name="RadioEco" Grid.Column="0" Margin="4" GroupName="Profiles"

                                         ToolTip="72 FPS verrouille. Resolution 80%. Ideal pour cartes graphiques GTX 1660 / RTX 2060 et Quest 2.">

                                <StackPanel Margin="4">

                                    <TextBlock Text="🟢 Eco / Quest 2" FontWeight="Bold" Foreground="#00FF88" FontSize="13" />

                                    <TextBlock Text="72 FPS • Resolution allegee • Ideal GTX 1660 / RTX 2060" FontSize="11" Foreground="#8FA7B3" TextWrapping="Wrap" Margin="0,2,0,0" />

                                </StackPanel>

                            </RadioButton>



                            <RadioButton x:Name="RadioBalanced" Grid.Column="1" Margin="4" GroupName="Profiles" IsChecked="True"

                                         ToolTip="90 FPS. Rendu Synced Sequential. Optimal pour RTX 3060+ et casques Quest 3 / Valve Index.">

                                <StackPanel Margin="4">

                                    <TextBlock Text="🟡 Equilibre (Recommande)" FontWeight="Bold" Foreground="#00F0FF" FontSize="13" />

                                    <TextBlock Text="90 FPS • Synced Sequential • Quest 3, Index &amp; RTX 3060+" FontSize="11" Foreground="#8FA7B3" TextWrapping="Wrap" Margin="0,2,0,0" />

                                </StackPanel>

                            </RadioButton>



                            <RadioButton x:Name="RadioUltra" Grid.Column="2" Margin="4" GroupName="Profiles"

                                         ToolTip="120 FPS. Distance de vue maximale. Rendu 100% natif. Necessite RTX 4080 ou 4090.">

                                <StackPanel Margin="4">

                                    <TextBlock Text="🔴 Ultra / Mythique" FontWeight="Bold" Foreground="#FF5252" FontSize="13" />

                                    <TextBlock Text="Distance max • Rendu 100% natif • RTX 4080 / 4090" FontSize="11" Foreground="#8FA7B3" TextWrapping="Wrap" Margin="0,2,0,0" />

                                </StackPanel>

                            </RadioButton>

                        </Grid>

                    </StackPanel>

                </Border>





                <!-- Carte : Casque VR / Quest 3 / ALVR -->

                <Border Style="{StaticResource CardPanel}" Background="#060F18" BorderBrush="#0A2535">

                    <StackPanel>

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>



                            <!-- Titre + badge casque -->

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">

                                <TextBlock Text="🥽 CASQUE VR DETECTE :" FontWeight="Bold" FontSize="12" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <Border x:Name="BadgeCasqueARK" Background="#0A1E2A" CornerRadius="4" Padding="10,3" VerticalAlignment="Center">

                                    <TextBlock x:Name="TxtCasqueBadgeARK" Text="🔍 Analyse..." FontSize="11" FontWeight="Bold" Foreground="#00D0FF" />

                                </Border>

                            </StackPanel>



                            <!-- CheckBox Quest 3 -->

                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">

                                <CheckBox x:Name="ChkQuest3Optimize" Content="⚡ Optimiser pour Quest 3 (Wi-Fi 6, 120Hz, H.265 — via ALVR / WiVRn)" Foreground="#C0D8E8"

                                          FontSize="12" IsChecked="False"

                                          ToolTip="Active les parametres optimaux pour Quest 3 : 120Hz, encode H.265, bitrate 200 Mbps. Requiert ALVR ou WiVRn installe sur le PC." />

                                <TextBlock x:Name="TxtFluxVRARK" Text="" FontSize="10" Foreground="#4A6A7A" Margin="20,3,0,0" />

                            </StackPanel>



                            <!-- Bouton telecharger ALVR -->

                            <Button x:Name="BtnInstallALVR" Grid.Column="2" Content="⬇ Installer ALVR" Style="{StaticResource DarkButton}" Foreground="#00D0FF" BorderBrush="#004A6A"

                                    Visibility="Collapsed" Click="BtnInstallALVR_Click"

                                    ToolTip="Ouvre la page GitHub de la derniere release ALVR (client streaming Quest 3 open-source et gratuit)." />

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- Carte : Modules Immersifs -->

                <Border Style="{StaticResource CardPanel}">

                    <StackPanel>

                        <TextBlock Text="⚙️ MODULES IMMERSIFS &amp; MONTURES 6DOF" FontWeight="Bold" FontSize="13" Foreground="#00F0FF" Margin="0,0,0,10" />



                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>



                            <StackPanel Grid.Column="0">

                                <CheckBox x:Name="ChkDisableClouds" Content="Supprimer nuages bugues (+20 FPS)" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5"

                                          ToolTip="Desactive le rendu volumetrique des nuages (r.VolumetricCloud=0). Gain moyen de 15-25 FPS sans impact visuel notable en VR." />

                                <CheckBox x:Name="ChkSyncedSequential" Content="Rendu 'Synced Sequential' anti-scintillement" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5"

                                          ToolTip="Active le mode de rendu Synced Sequential dans UEVR. Elimine le ghosting et le scintillement lors des mouvements rapides." />

                                <CheckBox x:Name="ChkDinoCamera" Content="Calibrage selle T-Rex 1ere personne" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5"

                                          ToolTip="Ajuste le point de vue VR pour etre positionne correctement sur la selle du T-Rex en vue 1ere personne 6DOF." />

                                <CheckBox x:Name="ChkPteroRoll" Content="Vol Pteranodon : roulis dynamique 6DOF" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5"

                                          ToolTip="Ajoute un roulis physique au vol du Pteranodon. L'horizon s'incline lors des virages pour une immersion maximale." />

                                <CheckBox x:Name="ChkDisableMotionBlur" Content="Desactiver le motion blur" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,4" FontSize="12.5"

                                          ToolTip="Desactive le flou de mouvement (r.MotionBlurQuality=0). Tres recommande en VR : le motion blur provoque de la nausee." />

                            </StackPanel>



                            <StackPanel Grid.Column="1">

                                <CheckBox x:Name="ChkVignette" Content="Vignette de confort anti-cinetose" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5"

                                          ToolTip="Active le filtre vignette de confort UEVR. Assombrit les bords du champ de vision lors des mouvements pour reduire la nausee." />

                                <CheckBox x:Name="ChkLaserSight" Content="Viseur laser Tek 3D projete" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5"

                                          ToolTip="Active le pointeur laser 3D holographique pour les armes Tek. Remplace le reticule 2D par un viseur projete dans l'espace." />

                                <CheckBox x:Name="ChkCpuPriority" Content="Priorite processeur elevee (CPU High)" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5"

                                          ToolTip="Lance ShooterGame.exe avec priorite CPU 'High'. Reduit les micro-stutters lies aux pics de charge processeur." />

                                <CheckBox x:Name="ChkBackupIni" Content="Sauvegarder Engine.ini avant modification" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5"

                                          ToolTip="Cree une copie Engine.ini.bak avant d'appliquer les tweaks VR. Permet une restauration manuelle rapide en cas de probleme." />

                                <CheckBox x:Name="ChkHighQualityTextures" Content="Pool textures etendu (VRAM 6 Go+)" IsChecked="False" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5"

                                          ToolTip="Augmente le pool de streaming de textures a 6144 Mo (r.Streaming.PoolSize=6144). Activer uniquement si vous avez 8 Go de VRAM ou plus." />

                                <CheckBox x:Name="ChkDesktopShortcut" Content="Creer raccourcis Bureau 'ARK VR (FR)'" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,4" FontSize="12.5"

                                          ToolTip="Cree un fichier .cmd sur le Bureau pour lancer ARK en VR d'un seul clic, sans passer par l'installateur." />

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>



                <!-- Carte : Console de Log -->

                <Border Style="{StaticResource CardPanel}">

                    <StackPanel>

                        <Grid Margin="0,0,0,8">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                                <TextBlock Text="📋 CONSOLE DE DEPLOIEMENT" FontWeight="Bold" FontSize="12" Foreground="#8FA7B3" VerticalAlignment="Center" />

                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                                <TextBlock x:Name="TxtProgressPercent" Text="Pret" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,10,0" />

                                <Button Content="Effacer" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="11" Click="BtnClearLog_Click" />

                            </StackPanel>

                        </Grid>

                        <ProgressBar x:Name="ProgressBar" Height="8" Background="#06090C" Foreground="#00FF88" BorderBrush="#1A2D38" BorderThickness="1" Margin="0,0,0,8" />

                        <!-- Console log scrollable -->

                        <Border Background="#040810" BorderBrush="#0F1E28" BorderThickness="1" CornerRadius="4">

                            <ListBox x:Name="LogConsole" RequestBringIntoView="LogConsole_RequestBringIntoView"

                                     Height="120"

                                     Background="Transparent"

                                     BorderThickness="0"

                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"

                                     ScrollViewer.VerticalScrollBarVisibility="Auto"

                                     ItemContainerStyle="{StaticResource LogItem}"

                                     Padding="6,4" />

                        </Border>

                    </StackPanel>

                </Border>



            </StackPanel>

        </ScrollViewer>



        <!-- Barre de boutons -->

        <Border Grid.Row="2" Background="#050D12" BorderBrush="#0F2030" BorderThickness="0,1,0,0" Padding="16,12">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>



                <Button x:Name="BtnInstall" Grid.Column="0" Content="🦖 INSTALLER ARK VR (FR)" Style="{StaticResource EmeraldButton}" Margin="0,0,10,0" Click="BtnInstall_Click" />

                <Button x:Name="BtnLaunch" Grid.Column="1" Content="🥽 LANCER EN VR" Style="{StaticResource GlowingButton}" Margin="0,0,10,0" Click="BtnLaunch_Click"

                        ToolTip="Lance UEVRInjector.exe puis ShooterGame.exe. Assurez-vous que votre casque est connecte." />

                <Button x:Name="BtnRestore" Grid.Column="2" Content="🔄 Restaurer Vanilla" Style="{StaticResource DarkButton}" Click="BtnRestore_Click"

                        ToolTip="Supprime les fichiers UEVR installes et restaure ARK en mode ecran plat. Vos sauvegardes ne sont pas touchees." />

            </Grid>

        </Border>

    </Grid>

</Window>





