<Window x:Class="ArkVRInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARK VR - Installateur &amp; Optimiseur (Édition Française v1.2.0) • LordMadTrix"
        Height="840" Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#070B0E"
        Foreground="#E0F7FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Styles et couleurs néon Tek & Jurassique -->
        <SolidColorBrush x:Key="BgDark" Color="#070B0E" />
        <SolidColorBrush x:Key="CardBg" Color="#0D151B" />
        <SolidColorBrush x:Key="CardBorder" Color="#1A2D38" />
        <SolidColorBrush x:Key="TekCyan" Color="#00F0FF" />
        <SolidColorBrush x:Key="TekEmerald" Color="#00FF88" />
        <SolidColorBrush x:Key="TextDim" Color="#8FA7B3" />

        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#0D151B" />
            <Setter Property="BorderBrush" Value="#1A2D38" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="GlowingButton" TargetType="Button">
            <Setter Property="Background" Value="#00E5FF" />
            <Setter Property="Foreground" Value="#051015" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33EFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00B8CC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmeraldButton" TargetType="Button" BasedOn="{StaticResource GlowingButton}">
            <Setter Property="Background" Value="#00FF88" />
            <Setter Property="Foreground" Value="#031A0F" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFA0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00CC6A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurpleButton" TargetType="Button" BasedOn="{StaticResource GlowingButton}">
            <Setter Property="Background" Value="#D946EF" />
            <Setter Property="Foreground" Value="#1A0222" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E879F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C026D3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#142129" />
            <Setter Property="Foreground" Value="#90CAF9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#253E4D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D303B" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête / Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Background="#0C141A" BorderBrush="#00F0FF" BorderThickness="0,0,0,2" CornerRadius="8,8,0,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🦖 ARK VR" FontSize="26" FontWeight="Bold" Foreground="#00F0FF" />
                        <Border Background="#00FF88" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ÉDITION FRANÇAISE v1.2.0" FontSize="11" FontWeight="Bold" Foreground="#041F12" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Survie Jurassique 6DOF, Vol Aérien en Ptéranodon &amp; Rendu Stéréoscopique UEVR" FontSize="13" Foreground="#8FA7B3" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#14222B" CornerRadius="6" BorderBrush="#00C8FF" BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Signé LordMadTrix" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" />
                </Border>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>

                <!-- Carte : Répertoire de jeu -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="📁 DOSSIER DU JEU (ARK: SURVIVAL EVOLVED)" FontWeight="Bold" FontSize="13" Foreground="#00F0FF" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGamePath" Grid.Column="0" Background="#06090C" Foreground="#E0F7FA" BorderBrush="#253E4D" BorderThickness="1" Padding="10,8" FontSize="13" VerticalContentAlignment="Center" />
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="Parcourir..." Style="{StaticResource DarkButton}" Margin="10,0,0,0" Click="BtnBrowse_Click" />
                        </Grid>
                        <TextBlock x:Name="TxtDetectStatus" Text="🔍 Recherche de ShooterGame.exe..." FontSize="12" Foreground="#00FF88" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Carte : Profils de Performance Matériel -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="🎛️ SÉLECTION DU PROFIL DE PERFORMANCE VR" FontWeight="Bold" FontSize="13" Foreground="#00F0FF" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="RadioEco" Grid.Column="0" Margin="4" GroupName="Profiles">
                                <StackPanel Margin="4">
                                    <TextBlock Text="🟢 Éco / Quest 2" FontWeight="Bold" Foreground="#00FF88" FontSize="13" />
                                    <TextBlock Text="72 FPS • Résolution allégée • Idéal GTX 1660 / RTX 2060" FontSize="11" Foreground="#8FA7B3" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioBalanced" Grid.Column="1" Margin="4" GroupName="Profiles" IsChecked="True">
                                <StackPanel Margin="4">
                                    <TextBlock Text="🟡 Équilibré (Recommandé)" FontWeight="Bold" Foreground="#00F0FF" FontSize="13" />
                                    <TextBlock Text="90 FPS • Synced Sequential • Quest 3, Index &amp; RTX 3060+" FontSize="11" Foreground="#8FA7B3" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioUltra" Grid.Column="2" Margin="4" GroupName="Profiles">
                                <StackPanel Margin="4">
                                    <TextBlock Text="🔴 Ultra / Mythique" FontWeight="Bold" Foreground="#FF5252" FontSize="13" />
                                    <TextBlock Text="Distance max • Rendu 100% natif • RTX 4080 / 4090" FontSize="11" Foreground="#8FA7B3" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Carte : Réglages & Optimisations Avancées -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="⚙️ MODULES IMMERSIFS &amp; MONTURES 6DOF" FontWeight="Bold" FontSize="13" Foreground="#00F0FF" Margin="0,0,0,10" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="ChkDisableClouds" Content="Supprimer nuages bugués (+20 FPS)" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5" />
                                <CheckBox x:Name="ChkSyncedSequential" Content="Rendu 'Synced Sequential' anti-scintillement" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5" />
                                <CheckBox x:Name="ChkDinoCamera" Content="Calibrage selle T-Rex 1ère personne" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5" />
                                <CheckBox x:Name="ChkPteroRoll" Content="Vol Ptéranodon : roulis dynamique 6DOF" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,4" FontSize="12.5" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkVignette" Content="Vignette de confort anti-cinétose" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5" />
                                <CheckBox x:Name="ChkLaserSight" Content="Viseur laser Tek 3D projeté" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5" />
                                <CheckBox x:Name="ChkCpuPriority" Content="Priorité processeur élevée (CPU High)" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,8" FontSize="12.5" />
                                <CheckBox x:Name="ChkDesktopShortcut" Content="Créer raccourcis Bureau 'ARK VR (FR)'" IsChecked="True" Foreground="#E0F7FA" Margin="0,0,0,4" FontSize="12.5" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Carte : Statut & Console de progression -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="ÉTAT DU DÉPLOIEMENT" FontWeight="Bold" FontSize="12" Foreground="#8FA7B3" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TxtProgressPercent" Text="Prêt" FontSize="12" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="ProgressBar" Height="10" Background="#06090C" Foreground="#00FF88" BorderBrush="#1A2D38" BorderThickness="1" />
                        <TextBlock x:Name="TxtStatus" Text="En attente de déploiement." FontSize="12" Foreground="#8FA7B3" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Actions / Boutons de commande -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnInstall" Grid.Column="0" Content="🦖 INSTALLER ARK VR (FR)" Style="{StaticResource EmeraldButton}" Margin="0,0,10,0" Click="BtnInstall_Click" />
            <Button x:Name="BtnLaunch" Grid.Column="1" Content="🥽 LANCER EN VR" Style="{StaticResource GlowingButton}" Margin="0,0,10,0" Click="BtnLaunch_Click" />
            <Button x:Name="BtnSimulator" Grid.Column="2" Content="🌐 SIMULATEUR 3D" Style="{StaticResource PurpleButton}" Margin="0,0,10,0" Click="BtnSimulator_Click" />
            <Button x:Name="BtnRestore" Grid.Column="3" Content="🔄 Restaurer Vanilla" Style="{StaticResource DarkButton}" Click="BtnRestore_Click" />
        </Grid>
    </Grid>
</Window>
