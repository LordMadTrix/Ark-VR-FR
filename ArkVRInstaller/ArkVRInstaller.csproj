<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>ArkVR-Setup</AssemblyName>
    <RootNamespace>ArkVRInstaller</RootNamespace>
    <ApplicationTitle>ARK VR - Installateur &amp; Optimiseur (Edition Francaise)</ApplicationTitle>
    <Company>LordMadTrix</Company>
    <Product>ARK VR Edition Francaise</Product>
    <Description>Installateur et optimiseur autonome pour ARK: Survival Evolved en Realite Virtuelle 6DOF native.</Description>
    <Version>1.4.0.0</Version>
    <FileVersion>1.4.0.0</FileVersion>

    <!-- Compression maximale du single-file (sans trimming WPF incompatible) -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- ReadyToRun desactive = EXE plus petit (pas de code natif pre-compile) -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Supprime les symboles de debug pour reduire la taille -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Optimisation du compilateur IL -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="app.ico" />
    <Resource Include="app.ico" />
    <None Remove="payload.zip" />
    <EmbeddedResource Include="payload.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>
